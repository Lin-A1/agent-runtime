{
  "name": "@newhorse/desktop",
  "private": true,
  "version": "1.21.0",
  "scripts": {
    "tauri": "tauri",
    "build": "bun run build:web && bun run build:sidecar && bun run tauri:build",
    "build:web": "cd ../web && bun run build",
    "build:sidecar": "bun build --compile --target=bun-windows-x64 ../../packages/server/src/main.ts --outfile src-tauri/binaries/newhorse-server-x86_64-pc-windows-msvc.exe",
    "sync:ui": "bun run build:web && rm -rf src-tauri/web-dist && cp -r ../web/dist src-tauri/web-dist",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
